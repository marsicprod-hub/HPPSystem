<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:HPPSystem.Views"
             xmlns:vm="using:HPPSystem.ViewModels"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:faStyle="using:FluentAvalonia.Styling"
             xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
             x:Class="HPPSystem.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="AppBgColor">#F8F4EF</Color>
          <Color x:Key="ChromeBgColor">#FFFFFF</Color>
          <Color x:Key="SidebarBgColor">#FFF8F3</Color>
          <Color x:Key="SidebarSurfaceColor">#FFF4EC</Color>
          <Color x:Key="SidebarSelectedColor">#F2B880</Color>
          <Color x:Key="SidebarSelectedTextColor">#FFFFFF</Color>
          <Color x:Key="SidebarTextColor">#7C6A77</Color>
          <Color x:Key="SidebarMutedColor">#B7A5A1</Color>
          <Color x:Key="TopbarBgColor">#FFFFFF</Color>
          <Color x:Key="TopbarBorderColor">#F0E2D7</Color>
          <Color x:Key="ContentBgColor">#FFFDFC</Color>
          <Color x:Key="ContentBorderColor">#F0E2D7</Color>
          <Color x:Key="CardBgColor">#FFFFFF</Color>
          <Color x:Key="CardAltBgColor">#FFF4EC</Color>
          <Color x:Key="CardBorderColor">#EEDDD0</Color>
          <Color x:Key="PrimaryTextColor">#34263A</Color>
          <Color x:Key="SecondaryTextColor">#967E87</Color>
          <Color x:Key="AccentColor">#966B9D</Color>
          <Color x:Key="AccentSoftColor">#E7CFBC</Color>
          <Color x:Key="AccentWarmColor">#F2B880</Color>
          <Color x:Key="AccentRoseColor">#C98686</Color>
          <Color x:Key="InputBgColor">#FBF7F4</Color>
          <Color x:Key="InputBorderColor">#F0E2D7</Color>
          <Color x:Key="InputHoverBorderColor">#E2C9B2</Color>
          <Color x:Key="InputFocusBorderColor">#966B9D</Color>
          <Color x:Key="ToastBgColor">#FFFFFF</Color>
          <Color x:Key="ToastFgColor">#34263A</Color>
          <Color x:Key="CardShadowColor">#2A1C2D</Color>
          <Color x:Key="MetricShadowColor">#2E202F</Color>
          <Color x:Key="ButtonDepthBorderColor">#DCC9BC</Color>
          <Color x:Key="ButtonShadowColor">#2A1C2D</Color>
          <Color x:Key="ButtonShadowHoverColor">#3A2140</Color>
          <Color x:Key="ButtonShadowPressedColor">#241527</Color>
          <Color x:Key="ButtonShadowDisabledColor">#1F1C2A</Color>
          <Color x:Key="FocusRingColor">#966B9D</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="AppBgColor">#101010</Color>
          <Color x:Key="ChromeBgColor">#161616</Color>
          <Color x:Key="SidebarBgColor">#131313</Color>
          <Color x:Key="SidebarSurfaceColor">#1B1B1B</Color>
          <Color x:Key="SidebarSelectedColor">#F2B880</Color>
          <Color x:Key="SidebarSelectedTextColor">#191919</Color>
          <Color x:Key="SidebarTextColor">#E8DDD4</Color>
          <Color x:Key="SidebarMutedColor">#A99A93</Color>
          <Color x:Key="TopbarBgColor">#171717</Color>
          <Color x:Key="TopbarBorderColor">#242424</Color>
          <Color x:Key="ContentBgColor">#111111</Color>
          <Color x:Key="ContentBorderColor">#202020</Color>
          <Color x:Key="CardBgColor">#181818</Color>
          <Color x:Key="CardAltBgColor">#231F1D</Color>
          <Color x:Key="CardBorderColor">#3A322E</Color>
          <Color x:Key="PrimaryTextColor">#F7EEE9</Color>
          <Color x:Key="SecondaryTextColor">#D0C0B7</Color>
          <Color x:Key="AccentColor">#F2B880</Color>
          <Color x:Key="AccentSoftColor">#332A24</Color>
          <Color x:Key="AccentWarmColor">#F2B880</Color>
          <Color x:Key="AccentRoseColor">#C98686</Color>
          <Color x:Key="InputBgColor">#201F1E</Color>
          <Color x:Key="InputBorderColor">#433833</Color>
          <Color x:Key="InputHoverBorderColor">#6C5648</Color>
          <Color x:Key="InputFocusBorderColor">#F2B880</Color>
          <Color x:Key="ToastBgColor">#1A1A1A</Color>
          <Color x:Key="ToastFgColor">#F7EEE9</Color>
          <Color x:Key="CardShadowColor">#66110D14</Color>
          <Color x:Key="MetricShadowColor">#8CF2B880</Color>
          <Color x:Key="ButtonDepthBorderColor">#7A665A</Color>
          <Color x:Key="ButtonShadowColor">#A6F2B880</Color>
          <Color x:Key="ButtonShadowHoverColor">#CCF2B880</Color>
          <Color x:Key="ButtonShadowPressedColor">#80F2B880</Color>
          <Color x:Key="ButtonShadowDisabledColor">#40F2B880</Color>
          <Color x:Key="FocusRingColor">#F2B880</Color>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <SolidColorBrush x:Key="AppBgBrush" Color="{DynamicResource AppBgColor}" />
      <SolidColorBrush x:Key="ChromeBgBrush" Color="{DynamicResource ChromeBgColor}" />
      <SolidColorBrush x:Key="SidebarBgBrush" Color="{DynamicResource SidebarBgColor}" />
      <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="{DynamicResource SidebarSurfaceColor}" />
      <SolidColorBrush x:Key="SidebarSelectedBrush" Color="{DynamicResource SidebarSelectedColor}" />
      <SolidColorBrush x:Key="SidebarSelectedTextBrush" Color="{DynamicResource SidebarSelectedTextColor}" />
      <SolidColorBrush x:Key="SidebarTextBrush" Color="{DynamicResource SidebarTextColor}" />
      <SolidColorBrush x:Key="SidebarMutedBrush" Color="{DynamicResource SidebarMutedColor}" />
      <SolidColorBrush x:Key="TopbarBgBrush" Color="{DynamicResource TopbarBgColor}" />
      <SolidColorBrush x:Key="TopbarBorderBrush" Color="{DynamicResource TopbarBorderColor}" />
      <SolidColorBrush x:Key="ContentBgBrush" Color="{DynamicResource ContentBgColor}" />
      <SolidColorBrush x:Key="ContentBorderBrush" Color="{DynamicResource ContentBorderColor}" />
      <SolidColorBrush x:Key="CardBgBrush" Color="{DynamicResource CardBgColor}" />
      <SolidColorBrush x:Key="CardAltBgBrush" Color="{DynamicResource CardAltBgColor}" />
      <SolidColorBrush x:Key="CardBorderBrush" Color="{DynamicResource CardBorderColor}" />
      <SolidColorBrush x:Key="PrimaryTextBrush" Color="{DynamicResource PrimaryTextColor}" />
      <SolidColorBrush x:Key="SecondaryTextBrush" Color="{DynamicResource SecondaryTextColor}" />
      <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="{DynamicResource AccentSoftColor}" />
      <SolidColorBrush x:Key="AccentWarmBrush" Color="{DynamicResource AccentWarmColor}" />
      <SolidColorBrush x:Key="AccentRoseBrush" Color="{DynamicResource AccentRoseColor}" />
      <SolidColorBrush x:Key="InputBgBrush" Color="{DynamicResource InputBgColor}" />
      <SolidColorBrush x:Key="InputBorderBrush" Color="{DynamicResource InputBorderColor}" />
      <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{DynamicResource InputHoverBorderColor}" />
      <SolidColorBrush x:Key="InputFocusBorderBrush" Color="{DynamicResource InputFocusBorderColor}" />
      <SolidColorBrush x:Key="ToastBgBrush" Color="{DynamicResource ToastBgColor}" />
      <SolidColorBrush x:Key="ToastFgBrush" Color="{DynamicResource ToastFgColor}" />
      <SolidColorBrush x:Key="ButtonDepthBorderBrush" Color="{DynamicResource ButtonDepthBorderColor}" />
      <SolidColorBrush x:Key="FocusRingBrush" Color="{DynamicResource FocusRingColor}" />
      <CornerRadius x:Key="PageCardCornerRadius">18</CornerRadius>
      <CornerRadius x:Key="MetricCardCornerRadius">14</CornerRadius>
      <CornerRadius x:Key="InputCornerRadius">12</CornerRadius>
      <Thickness x:Key="PageCardPadding">18</Thickness>
      <Thickness x:Key="MetricCardPadding">12</Thickness>
    </ResourceDictionary>
  </Application.Resources>

  <Application.DataTemplates>
    <DataTemplate DataType="vm:DashboardViewModel">
      <v:DashboardView />
    </DataTemplate>
    <DataTemplate DataType="vm:MaterialsViewModel">
      <v:MaterialsView />
    </DataTemplate>
    <DataTemplate DataType="vm:WarehouseViewModel">
      <v:WarehouseView />
    </DataTemplate>
    <DataTemplate DataType="vm:RecipesViewModel">
      <v:RecipesView />
    </DataTemplate>
    <DataTemplate DataType="vm:CombosViewModel">
      <v:CombosView />
    </DataTemplate>
    <DataTemplate DataType="vm:PosViewModel">
      <v:PosView />
    </DataTemplate>
    <DataTemplate DataType="vm:BookkeepingViewModel">
      <v:BookkeepingView />
    </DataTemplate>
    <DataTemplate DataType="vm:SimulationViewModel">
      <v:SimulationView />
    </DataTemplate>
    <DataTemplate DataType="vm:ProfileViewModel">
      <v:ProfileView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <v:SettingsView />
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <faStyle:FluentAvaloniaTheme />
    <material:MaterialIconStyles />
    <Style Selector="Border.page-card">
      <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource PageCardCornerRadius}" />
      <Setter Property="Padding" Value="{DynamicResource PageCardPadding}" />
      <Setter Property="Effect">
        <DropShadowEffect BlurRadius="14" OffsetX="0" OffsetY="4" Opacity="0.18" Color="{DynamicResource CardShadowColor}" />
      </Setter>
    </Style>
    <Style Selector="Border.metric-card">
      <Setter Property="Background" Value="{DynamicResource CardAltBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource MetricCardCornerRadius}" />
      <Setter Property="Padding" Value="{DynamicResource MetricCardPadding}" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Effect">
        <DropShadowEffect BlurRadius="10" OffsetX="0" OffsetY="3" Opacity="0.14" Color="{DynamicResource MetricShadowColor}" />
      </Setter>
    </Style>
    <Style Selector="TextBlock.kpi-label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="Black" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
    <Style Selector="TextBlock.section-subtitle">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource InputCornerRadius}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="TextBox:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
    </Style>
    <Style Selector="TextBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Effect">
        <DropShadowEffect BlurRadius="10" OffsetX="0" OffsetY="0" Opacity="0.35" Color="{DynamicResource FocusRingColor}" />
      </Setter>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource InputCornerRadius}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="MinHeight" Value="42" />
    </Style>
    <Style Selector="ComboBox:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
    </Style>
    <Style Selector="ComboBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Effect">
        <DropShadowEffect BlurRadius="10" OffsetX="0" OffsetY="0" Opacity="0.35" Color="{DynamicResource FocusRingColor}" />
      </Setter>
    </Style>
    <Style Selector="fa|NumberBox">
      <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="MinHeight" Value="42" />
    </Style>
    <Style Selector="fa|NumberBox:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
    </Style>
    <Style Selector="fa|NumberBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Effect">
        <DropShadowEffect BlurRadius="10" OffsetX="0" OffsetY="0" Opacity="0.35" Color="{DynamicResource FocusRingColor}" />
      </Setter>
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="2" />
    </Style>
    <Style Selector="CheckBox:focus">
      <Setter Property="Effect">
        <DropShadowEffect BlurRadius="8" OffsetX="0" OffsetY="0" Opacity="0.28" Color="{DynamicResource FocusRingColor}" />
      </Setter>
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonDepthBorderBrush}" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform">
        <ScaleTransform ScaleX="1" ScaleY="1" />
      </Setter>
      <Setter Property="Effect">
        <DropShadowEffect BlurRadius="10" OffsetX="0" OffsetY="4" Opacity="0.35" Color="{DynamicResource ButtonShadowColor}" />
      </Setter>
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="RenderTransform">
        <ScaleTransform ScaleX="1.015" ScaleY="1.015" />
      </Setter>
      <Setter Property="Effect">
        <DropShadowEffect BlurRadius="14" OffsetX="0" OffsetY="6" Opacity="0.42" Color="{DynamicResource ButtonShadowHoverColor}" />
      </Setter>
      <Setter Property="BorderThickness" Value="1,1,1,2" />
    </Style>
    <Style Selector="Button:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Effect">
        <DropShadowEffect BlurRadius="14" OffsetX="0" OffsetY="0" Opacity="0.32" Color="{DynamicResource FocusRingColor}" />
      </Setter>
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="RenderTransform">
        <TranslateTransform X="0" Y="1" />
      </Setter>
      <Setter Property="Effect">
        <DropShadowEffect BlurRadius="6" OffsetX="0" OffsetY="2" Opacity="0.28" Color="{DynamicResource ButtonShadowPressedColor}" />
      </Setter>
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Effect">
        <DropShadowEffect BlurRadius="2" OffsetX="0" OffsetY="1" Opacity="0.12" Color="{DynamicResource ButtonShadowDisabledColor}" />
      </Setter>
    </Style>
    <Style Selector="Button.btn-primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarSelectedTextBrush}" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.btn-secondary">
      <Setter Property="Background" Value="{DynamicResource CardAltBgBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.btn-danger">
      <Setter Property="Background" Value="{DynamicResource AccentRoseBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarSelectedTextBrush}" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.btn-warm">
      <Setter Property="Background" Value="{DynamicResource AccentWarmBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarSelectedTextBrush}" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.btn-ghost">
      <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.btn-sm">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="{DynamicResource CardAltBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge.badge-soft">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Border.badge.badge-warm">
      <Setter Property="Background" Value="{DynamicResource AccentWarmBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentWarmBrush}" />
    </Style>
    <Style Selector="Border.badge.badge-danger">
      <Setter Property="Background" Value="{DynamicResource AccentRoseBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentRoseBrush}" />
    </Style>
    <Style Selector="fa|InfoBar.inline-info">
      <Setter Property="IsClosable" Value="False" />
      <Setter Property="Margin" Value="0,2,0,2" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.empty-state">
      <Setter Property="Background" Value="{DynamicResource CardAltBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="StackPanel.action-row">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="8" />
    </Style>
    <Style Selector="WrapPanel.action-row">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="ItemSpacing" Value="8" />
      <Setter Property="LineSpacing" Value="8" />
    </Style>
    <Style Selector="WrapPanel.kpi-grid">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="ItemSpacing" Value="12" />
      <Setter Property="LineSpacing" Value="12" />
    </Style>
    <Style Selector="dg|DataGrid.audit-grid">
      <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="MinHeight" Value="180" />
      <Setter Property="RowHeight" Value="46" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="CanUserSortColumns" Value="True" />
      <Setter Property="IsReadOnly" Value="True" />
    </Style>
    <Style Selector="dg|DataGrid.audit-grid:focus">
      <Setter Property="Effect">
        <DropShadowEffect BlurRadius="10" OffsetX="0" OffsetY="0" Opacity="0.24" Color="{DynamicResource FocusRingColor}" />
      </Setter>
    </Style>
    <Style Selector="dg|DataGrid.audit-grid dg|DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource CardAltBgBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    </Style>
    <Style Selector="dg|DataGrid.audit-grid dg|DataGridCell">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="dg|DataGrid.audit-grid dg|DataGridRow">
      <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
    </Style>
    <Style Selector="dg|DataGrid.audit-grid dg|DataGridRow:nth-child(even)">
      <Setter Property="Background" Value="{DynamicResource CardAltBgBrush}" />
    </Style>
    <Style Selector="dg|DataGrid.editor-grid">
      <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="MinHeight" Value="160" />
      <Setter Property="RowHeight" Value="58" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="CanUserSortColumns" Value="False" />
      <Setter Property="IsReadOnly" Value="False" />
    </Style>
    <Style Selector="dg|DataGrid.editor-grid dg|DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource CardAltBgBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    </Style>
    <Style Selector="dg|DataGrid.editor-grid dg|DataGridCell">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="fa|InfoBar.hint">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </Application.Styles>
</Application>
