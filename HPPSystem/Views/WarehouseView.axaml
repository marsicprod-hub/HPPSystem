<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HPPSystem.ViewModels"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
             xmlns:lottie="using:Avalonia.Skia.Lottie"
             xmlns:icon="clr-namespace:Lucide.Avalonia;assembly=Lucide.Avalonia"
             x:Class="HPPSystem.Views.WarehouseView"
             x:DataType="vm:WarehouseViewModel"
             x:Name="Root">
  <ScrollViewer Padding="0,0,16,0">
    <StackPanel Spacing="14">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
        <StackPanel Spacing="4">
          <TextBlock Text="Gudang" FontSize="{DynamicResource AppPageTitleFontSize}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
          <TextBlock Text="Kelola stok fisik, audit pergerakan, dan fokus restock per bahan. Identitas bahan mengikuti nama dan merk dari katalog material." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <WrapPanel Grid.Column="1" Classes="action-row" HorizontalAlignment="Right" VerticalAlignment="Top">
          <Border Classes="badge badge-soft" Padding="12,6" HorizontalAlignment="Right">
            <TextBlock Text="{Binding TotalStockText}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" FontSize="{DynamicResource AppCaptionFontSize}" />
          </Border>
        </WrapPanel>
      </Grid>

      <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
        <Border Grid.Column="0" Classes="page-card">
          <StackPanel Spacing="6">
            <icon:LucideIcon Kind="Warehouse" Classes="metric-icon" />
            <TextBlock Text="Bahan Aktif" Classes="kpi-label" />
            <TextBlock Text="{Binding MaterialCountText}" FontSize="{DynamicResource AppDisplayFontSize}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="page-card">
          <StackPanel Spacing="6">
            <icon:LucideIcon Kind="TriangleAlert" Classes="metric-icon" />
            <TextBlock Text="Stok Tipis" Classes="kpi-label" />
            <TextBlock Text="{Binding LowStockCountText}" FontSize="{DynamicResource AppDisplayFontSize}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="page-card">
          <StackPanel Spacing="6">
            <icon:LucideIcon Kind="Database" Classes="metric-icon" />
            <TextBlock Text="Total Stok" Classes="kpi-label" />
            <TextBlock Text="{Binding TotalStockText}" FontSize="{DynamicResource AppDisplayFontSize}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="3" Classes="page-card">
          <StackPanel Spacing="6">
            <icon:LucideIcon Kind="RefreshCw" Classes="metric-icon" />
            <TextBlock Text="Delta Update" Classes="kpi-label" />
            <TextBlock Text="{Binding AdjustmentDeltaText}" FontSize="{DynamicResource AppDisplayFontSize}" FontWeight="Black" Foreground="{DynamicResource AccentWarmBrush}" />
          </StackPanel>
        </Border>
      </Grid>

      <StackPanel Spacing="12">
        <StackPanel Spacing="12">
          <Border Classes="page-card">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="Daftar Stok Bahan" FontSize="{DynamicResource AppCardTitleFontSize}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
                  <TextBlock Text="Cari bahan, pantau stok tipis, lalu atur stok fisik langsung dari daftar gudang." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <WrapPanel Grid.Column="1" Classes="action-row" HorizontalAlignment="Right" VerticalAlignment="Top">
                  <Border Classes="badge badge-soft" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SearchSummaryText}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" />
                  </Border>
                  <Border Classes="badge badge-soft" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RestockFocusText}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" MaxWidth="240" TextTrimming="CharacterEllipsis" />
                  </Border>
                </WrapPanel>
              </Grid>

              <StackPanel Spacing="8">
                <WrapPanel Classes="kpi-grid">
                  <StackPanel Width="260" Spacing="6">
                    <TextBlock Text="Cari Bahan" Classes="kpi-label" />
                    <TextBox Text="{Binding SearchTerm}" Watermark="Cari nama bahan atau merk..." />
                  </StackPanel>
                  <StackPanel Width="240" Spacing="6">
                    <TextBlock Text="Urutkan Tabel" Classes="kpi-label" />
                    <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:SelectionOptionViewModel">
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                </WrapPanel>
                <WrapPanel Classes="action-row">
                  <TextBlock Text="{Binding SearchHelperText}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                  <Border Classes="badge badge-soft">
                    <TextBlock Text="{Binding SortSummaryText}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" />
                  </Border>
                </WrapPanel>
              </StackPanel>

              <StackPanel Spacing="6">
                <WrapPanel Classes="action-row">
                  <Grid>
                    <Button Classes="btn-primary btn-sm" IsVisible="{Binding IsFocusAll}" Command="{Binding FocusAllCommand}">
                      <TextBlock Text="{Binding FocusAllText}" />
                    </Button>
                    <Button Classes="btn-secondary btn-sm" IsVisible="{Binding !IsFocusAll}" Command="{Binding FocusAllCommand}">
                      <TextBlock Text="{Binding FocusAllText}" />
                    </Button>
                  </Grid>
                  <Grid>
                    <Button Classes="btn-primary btn-sm" IsVisible="{Binding IsFocusCritical}" Command="{Binding FocusCriticalCommand}">
                      <TextBlock Text="{Binding FocusCriticalText}" />
                    </Button>
                    <Button Classes="btn-secondary btn-sm" IsVisible="{Binding !IsFocusCritical}" Command="{Binding FocusCriticalCommand}">
                      <TextBlock Text="{Binding FocusCriticalText}" />
                    </Button>
                  </Grid>
                  <Grid>
                    <Button Classes="btn-primary btn-sm" IsVisible="{Binding IsFocusOut}" Command="{Binding FocusOutCommand}">
                      <TextBlock Text="{Binding FocusOutText}" />
                    </Button>
                    <Button Classes="btn-secondary btn-sm" IsVisible="{Binding !IsFocusOut}" Command="{Binding FocusOutCommand}">
                      <TextBlock Text="{Binding FocusOutText}" />
                    </Button>
                  </Grid>
                  <Button Classes="btn-warm btn-sm" Command="{Binding ClearSearchAndFocusCommand}" IsVisible="{Binding HasActiveSearchOrFocus}">
                    <TextBlock Text="Reset Fokus" />
                  </Button>
                </WrapPanel>
                <TextBlock Text="{Binding MaterialFocusSummaryText}" Foreground="{DynamicResource SecondaryTextBrush}" />
              </StackPanel>

              <Border Classes="empty-state" IsVisible="{Binding !HasMaterials}">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                  <lottie:Lottie Width="120" Height="120" Path="avares://HPPSystem/Assets/Animations/empty-pulse.json" />
                  <TextBlock Text="Belum ada stok bahan" FontSize="{DynamicResource AppDisplaySmallFontSize}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" />
                  <TextBlock Text="Tambahkan bahan dari halaman Material lalu atur stok awalnya di Gudang." Foreground="{DynamicResource SecondaryTextBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
                </StackPanel>
              </Border>

              <dg:DataGrid Classes="audit-grid"
                           ItemsSource="{Binding MaterialCards}"
                           IsVisible="{Binding HasMaterials}"
                           AutoGenerateColumns="False"
                           MinHeight="420"
                           CanUserResizeColumns="True">
                <dg:DataGrid.Columns>
                  <dg:DataGridTextColumn Header="Bahan" Binding="{Binding NameText}" Width="2*" />
                  <dg:DataGridTextColumn Header="Merk" Binding="{Binding BrandText}" Width="1.4*" />
                  <dg:DataGridTextColumn Header="Stok" Binding="{Binding StockQuantityValue, StringFormat='{}{0:0.##}'}" Width="*" />
                  <dg:DataGridTextColumn Header="Satuan" Binding="{Binding StockUnitText}" Width="*" />
                  <dg:DataGridTextColumn Header="Status" Binding="{Binding StockStatusText}" Width="*" />
                  <dg:DataGridTextColumn Header="Harga Pack" Binding="{Binding PackPriceValue, StringFormat='Rp{0:N0}'}" Width="*" />
                  <dg:DataGridTextColumn Header="Isi per Pack" Binding="{Binding PackQuantityValue, StringFormat='{}{0:0.##}'}" Width="*" />
                  <dg:DataGridTextColumn Header="Biaya Satuan" Binding="{Binding UnitCostValue, StringFormat='Rp{0:N0}'}" Width="*" />
                  <dg:DataGridTextColumn Header="Balance" Binding="{Binding StockBalanceValue, StringFormat='{}{0:0.##}'}" Width="*" />
                  <dg:DataGridTemplateColumn Header="Aksi" Width="280">
                    <dg:DataGridTemplateColumn.CellTemplate>
                      <DataTemplate DataType="vm:MaterialCardViewModel">
                        <WrapPanel Classes="action-row">
                          <Button Classes="btn-ghost btn-sm" Command="{Binding #Root.DataContext.ShowHistoryForCommand}" CommandParameter="{Binding Material}">
                            <TextBlock Text="Riwayat" />
                          </Button>
                          <Button Classes="btn-primary btn-sm" Command="{Binding #Root.DataContext.StartAdjustCommand}" CommandParameter="{Binding Material}">
                            <TextBlock Text="Atur Stok" />
                          </Button>
                          <Button Classes="btn-danger btn-sm" Command="{Binding #Root.DataContext.RequestDeleteFromWarehouseCommand}" CommandParameter="{Binding Material}">
                            <TextBlock Text="Hapus" />
                          </Button>
                        </WrapPanel>
                      </DataTemplate>
                    </dg:DataGridTemplateColumn.CellTemplate>
                  </dg:DataGridTemplateColumn>
                </dg:DataGrid.Columns>
              </dg:DataGrid>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="12">
          <Border Classes="page-card">
            <StackPanel Spacing="12">
              <StackPanel Spacing="4" IsVisible="{Binding ShowAdjustForm}">
                <TextBlock Text="{Binding AdjustFormTitleText}" FontSize="{DynamicResource AppCardTitleFontSize}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="{Binding AdjustFormHelperText}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Spacing="8" IsVisible="{Binding !ShowAdjustForm}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Aktifkan Material ke Gudang" FontSize="{DynamicResource AppCardTitleFontSize}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="{Binding InventoryInsightText}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Border Grid.Column="1" Classes="badge badge-soft" VerticalAlignment="Top">
                    <TextBlock Text="{Binding CatalogPickerSummaryText}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" TextWrapping="Wrap" />
                  </Border>
                  <Button Grid.Column="2" Classes="btn-secondary btn-sm" Command="{Binding FocusRestockPriorityCommand}" IsEnabled="{Binding HasQuickRestockTarget}" VerticalAlignment="Top">
                    <TextBlock Text="Fokus Restock" />
                  </Button>
                </Grid>

                <Grid ColumnDefinitions="1.6*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Material dari Katalog" Classes="kpi-label" />
                    <TextBox Text="{Binding CatalogSearchTerm}" Watermark="Cari nama bahan atau merk katalog..." />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Text="{Binding CatalogSearchHelperText}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                      <Button Grid.Column="1" Classes="btn-secondary btn-sm" IsVisible="{Binding HasCatalogSearchTerm}" Command="{Binding ClearCatalogSearchCommand}">
                        <TextBlock Text="Reset" />
                      </Button>
                    </Grid>
                    <ComboBox ItemsSource="{Binding CatalogMaterialOptions}"
                              SelectedItem="{Binding SelectedCatalogMaterialOption}"
                              IsEnabled="{Binding HasCatalogMaterialOptions}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:SelectionOptionViewModel">
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>

                  <Button Grid.Column="1"
                          Classes="btn-primary"
                          Command="{Binding AddCatalogMaterialCommand}"
                          IsEnabled="{Binding CanAddCatalogMaterial}"
                          VerticalAlignment="Bottom">
                    <TextBlock Text="Masukkan ke Gudang" TextAlignment="Center" />
                  </Button>
                </Grid>
              </StackPanel>

              <StackPanel Spacing="12" IsVisible="{Binding ShowAdjustForm}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBlock Text="Delta perubahan" Classes="kpi-label" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding AdjustmentDeltaText}" FontWeight="Black" Foreground="{DynamicResource AccentWarmBrush}" />
                </Grid>

                <WrapPanel Classes="kpi-grid">
                  <StackPanel Width="220" Spacing="6">
                    <TextBlock Text="Stok Saat Ini" Classes="kpi-label" />
                    <fa:NumberBox Value="{Binding CurrentStock}" IsEnabled="False" SpinButtonPlacementMode="Compact" />
                  </StackPanel>

                  <StackPanel Width="220" Spacing="6">
                    <TextBlock Text="Stok Fisik Baru" Classes="kpi-label" />
                    <fa:NumberBox Value="{Binding NewStock}" SmallChange="1" Minimum="0" SpinButtonPlacementMode="Compact" />
                  </StackPanel>
                </WrapPanel>

                <StackPanel Spacing="6">
                  <TextBlock Text="Catatan Audit" Classes="kpi-label" />
                  <TextBox Text="{Binding AdjustmentNotes}" Watermark="Opsional: hasil stock opname / koreksi rak / dsb" />
                </StackPanel>

                <WrapPanel Classes="action-row">
                  <Button Classes="btn-primary" Command="{Binding SaveStockCommand}" IsEnabled="{Binding CanSaveAdjustment}">
                    <TextBlock Text="Simpan Stok" />
                  </Button>
                  <Button Classes="btn-secondary" Command="{Binding CancelAdjustCommand}">
                    <TextBlock Text="Batal" />
                  </Button>
                </WrapPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="page-card" IsVisible="{Binding ShowHistory}">
            <Grid>
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding HistoryTitleText}" FontSize="{DynamicResource AppCardTitleFontSize}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="{Binding HistorySummaryText}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="btn-secondary" Command="{Binding CloseHistoryCommand}">
                    <TextBlock Text="Tutup" />
                  </Button>
                </Grid>

                <StackPanel Spacing="8">
                  <TextBlock Text="Riwayat Harga" FontSize="{DynamicResource AppSectionFontSize}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
                  <TextBlock Text="{Binding HistoryPriceCountText}" Foreground="{DynamicResource SecondaryTextBrush}" />

                  <Border Classes="metric-card" IsVisible="{Binding !HasHistoryPriceRecords}">
                    <TextBlock Text="Belum ada perubahan harga yang tercatat untuk bahan ini." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                  </Border>

                  <dg:DataGrid Classes="audit-grid"
                               ItemsSource="{Binding HistoryPriceRecords}"
                               IsVisible="{Binding HasHistoryPriceRecords}"
                               AutoGenerateColumns="False"
                               MinHeight="180">
                    <dg:DataGrid.Columns>
                      <dg:DataGridTextColumn Header="Tanggal" Binding="{Binding DateValue, StringFormat='{}{0:dd MMM yyyy HH:mm}'}" Width="1.4*" />
                      <dg:DataGridTextColumn Header="Harga Pack" Binding="{Binding PriceValue, StringFormat='Rp{0:N0}'}" Width="*" />
                    </dg:DataGrid.Columns>
                  </dg:DataGrid>
                </StackPanel>

                <StackPanel Spacing="8">
                  <TextBlock Text="Pergerakan Stok" FontSize="{DynamicResource AppSectionFontSize}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
                  <TextBlock Text="{Binding HistoryMovementCountText}" Foreground="{DynamicResource SecondaryTextBrush}" />

                  <Border Classes="metric-card" IsVisible="{Binding !HasHistoryStockMovements}">
                    <TextBlock Text="Belum ada ledger stok untuk bahan ini." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                  </Border>

                  <dg:DataGrid Classes="audit-grid"
                               ItemsSource="{Binding HistoryStockMovements}"
                               IsVisible="{Binding HasHistoryStockMovements}"
                               AutoGenerateColumns="False"
                               MinHeight="220">
                    <dg:DataGrid.Columns>
                      <dg:DataGridTextColumn Header="Tanggal" Binding="{Binding DateText}" Width="1.2*" />
                      <dg:DataGridTextColumn Header="Sumber" Binding="{Binding SourceText}" Width="1.4*" />
                      <dg:DataGridTextColumn Header="Perubahan" Binding="{Binding QuantityText}" Width="*" />
                      <dg:DataGridTextColumn Header="Balance" Binding="{Binding BalanceText}" Width="1.2*" />
                      <dg:DataGridTextColumn Header="Catatan" Binding="{Binding NotesText}" Width="2*" />
                    </dg:DataGrid.Columns>
                  </dg:DataGrid>
                </StackPanel>
              </StackPanel>

            </Grid>
          </Border>

          <Border Classes="page-card">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="Ledger Gudang" FontSize="{DynamicResource AppCardTitleFontSize}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
                  <TextBlock Text="{Binding LedgerHeadlineText}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" Classes="badge badge-soft" VerticalAlignment="Top">
                  <TextBlock Text="{Binding LedgerInboundCountText}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" />
                </Border>
                <Border Grid.Column="2" Classes="badge badge-soft" VerticalAlignment="Top">
                  <TextBlock Text="{Binding LedgerOutboundCountText}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" />
                </Border>
              </Grid>

              <WrapPanel Classes="kpi-grid">
                <StackPanel Width="180" Spacing="6">
                  <TextBlock Text="Filter Sumber" Classes="kpi-label" />
                  <ComboBox ItemsSource="{Binding LedgerSourceOptions}" SelectedItem="{Binding SelectedLedgerSourceOption}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="vm:SelectionOptionViewModel">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Width="180" Spacing="6">
                  <TextBlock Text="Filter Bahan" Classes="kpi-label" />
                  <ComboBox ItemsSource="{Binding LedgerMaterialOptions}" SelectedItem="{Binding SelectedLedgerMaterialOption}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate DataType="vm:SelectionOptionViewModel">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </WrapPanel>

              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Text="{Binding LedgerFilterSummaryText}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                <Border Grid.Column="1" Classes="badge badge-soft" CornerRadius="14" Padding="14,10">
                  <TextBlock Text="{Binding LedgerMovementCountText}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" />
                </Border>
              </Grid>

              <Border Classes="metric-card" IsVisible="{Binding !HasLedgerStockMovements}">
                <TextBlock Text="Ledger stok belum punya data untuk filter yang dipilih." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
              </Border>

              <dg:DataGrid Classes="audit-grid"
                           ItemsSource="{Binding LedgerStockMovements}"
                           IsVisible="{Binding HasLedgerStockMovements}"
                           AutoGenerateColumns="False"
                           MinHeight="260"
                           CanUserResizeColumns="True">
                <dg:DataGrid.Columns>
                  <dg:DataGridTextColumn Header="Bahan" Binding="{Binding MaterialNameText}" Width="1.8*" />
                  <dg:DataGridTextColumn Header="Tanggal" Binding="{Binding DateText}" Width="1.2*" />
                  <dg:DataGridTextColumn Header="Sumber" Binding="{Binding SourceText}" Width="1.4*" />
                  <dg:DataGridTextColumn Header="Perubahan" Binding="{Binding QuantityText}" Width="*" />
                  <dg:DataGridTextColumn Header="Balance" Binding="{Binding BalanceText}" Width="1.2*" />
                  <dg:DataGridTextColumn Header="Catatan" Binding="{Binding NotesText}" Width="2*" />
                </dg:DataGrid.Columns>
              </dg:DataGrid>
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
