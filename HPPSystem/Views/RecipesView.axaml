<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HPPSystem.ViewModels"
             xmlns:model="using:HPPSystem.Models"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
             xmlns:fi="using:FluentIcons.Avalonia"
             xmlns:lottie="using:Avalonia.Skia.Lottie"
             x:Class="HPPSystem.Views.RecipesView"
             x:Name="Root"
             x:DataType="vm:RecipesViewModel">
  <ScrollViewer Padding="0,0,16,0">
    <StackPanel Spacing="18">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
        <StackPanel Spacing="4">
          <TextBlock Text="Resep" FontSize="28" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
          <TextBlock Text="Bangun costing, pricing, dan alur produksi dalam studio resep yang lebih jelas." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Classes="hint" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Right">
          <Border Classes="badge badge-soft" Padding="12,6" HorizontalAlignment="Right">
            <TextBlock Text="{Binding TopRecipeRecommendedPriceText}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" FontSize="11" />
          </Border>
          <Button Classes="btn-primary" Command="{Binding StartCreateCommand}" Padding="16,10" CornerRadius="14">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <fi:FluentIcon Icon="Add" IconVariant="Filled" FontSize="16" Foreground="{DynamicResource SidebarSelectedTextBrush}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Tambah Resep" />
            </Grid>
          </Button>
        </StackPanel>
      </Grid>

      <fa:InfoBar IsOpen="True"
                  Classes="hint inline-info"
                  Severity="Informational"
                  IsClosable="False"
                  Message="{Binding LibraryInsightText}" />

      <Border Classes="page-card" Background="{DynamicResource CardAltBgBrush}">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
          <StackPanel Spacing="4">
            <TextBlock Text="Arah Library Resep" FontSize="20" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBlock Text="{Binding LibraryFocusText}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Classes="hint" />
          </StackPanel>
          <Border Grid.Column="1" Classes="badge" Padding="12,6">
            <TextBlock Text="{Binding TopRecipeMarginText}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" FontSize="11" />
          </Border>
          <Border Grid.Column="2" Classes="badge badge-warm" Padding="12,6">
            <TextBlock Text="{Binding TopRecipeNameText}" Foreground="{DynamicResource SidebarSelectedTextBrush}" FontWeight="Bold" FontSize="11" />
          </Border>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
        <Border Grid.Column="0" Classes="page-card">
          <StackPanel Spacing="8">
            <fi:FluentIcon Icon="Food" IconVariant="Regular" FontSize="20" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="Resep Aktif" Classes="kpi-label" />
            <TextBlock Text="{Binding TotalRecipeCountText}" FontSize="24" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="page-card">
          <StackPanel Spacing="8">
            <fi:FluentIcon Icon="ArrowUpRight" IconVariant="Regular" FontSize="20" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="Output Batch" Classes="kpi-label" />
            <TextBlock Text="{Binding TotalPortionCapacityText}" FontSize="24" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="page-card">
          <StackPanel Spacing="8">
            <fi:FluentIcon Icon="Calculator" IconVariant="Regular" FontSize="20" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="Rata-rata HPP" Classes="kpi-label" />
            <TextBlock Text="{Binding AverageHppText}" FontSize="24" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="3" Classes="page-card">
          <StackPanel Spacing="8">
            <fi:FluentIcon Icon="Layer" IconVariant="Regular" FontSize="20" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="Jejak Bahan" Classes="kpi-label" />
            <TextBlock Text="{Binding TotalIngredientFootprintText}" FontSize="24" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Classes="page-card" IsVisible="{Binding IsEditing}">
        <Grid ColumnDefinitions="1.85*,*" ColumnSpacing="16">
          <StackPanel Spacing="14">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding EditorTitleText}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
              <TextBlock Text="{Binding EditorSubtitleText}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Classes="hint" />
            </StackPanel>

            <Border Classes="metric-card" Background="{DynamicResource AccentSoftBrush}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Text="{Binding EditorStructureText}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding EditorPricingGuideText}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" TextWrapping="Wrap" MaxWidth="220" TextAlignment="Right" Classes="hint" />
              </Grid>
            </Border>

            <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="10">
              <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Text="Nama Resep" Classes="kpi-label" />
                <TextBox Text="{Binding Editor.Name}" Watermark="Contoh: Rice Bowl Signature" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="Porsi per Batch" Classes="kpi-label" />
                <fa:NumberBox Value="{Binding Editor.Portions}" SmallChange="1" Minimum="1" SpinButtonPlacementMode="Compact" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Text="Target Margin" Classes="kpi-label" />
                <fa:NumberBox Value="{Binding Editor.TargetMargin}" SmallChange="5" Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact" />
              </StackPanel>
            </Grid>

            <Border Background="{DynamicResource CardAltBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="14">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Struktur Bahan" FontSize="18" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="Pisahkan resep per kelompok agar lebih mudah dibaca saat costing dan produksi." Foreground="{DynamicResource SecondaryTextBrush}" Classes="hint" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="btn-primary" Command="{Binding AddGroupCommand}">
                    <TextBlock Text="Tambah Kelompok" />
                  </Button>
                </Grid>

                <ItemsControl ItemsSource="{Binding Editor.Groups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:IngredientGroupEditorViewModel">
                      <Border Margin="0,0,0,8" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="12">
                        <StackPanel Spacing="10">
                          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0" Text="{Binding Name}" />
                            <Button Grid.Column="1" Classes="btn-secondary btn-sm" Command="{Binding #Root.DataContext.AddIngredientCommand}" CommandParameter="{Binding .}">
                              <TextBlock Text="Tambah Bahan" />
                            </Button>
                            <Button Grid.Column="2" Classes="btn-danger btn-sm" Command="{Binding #Root.DataContext.RemoveGroupCommand}" CommandParameter="{Binding .}">
                              <TextBlock Text="Hapus" />
                            </Button>
                          </Grid>

                          <ItemsControl ItemsSource="{Binding Ingredients}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="vm:IngredientEntryViewModel">
                                <Border Margin="0,0,0,8" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="10">
                                  <Grid ColumnDefinitions="2.2*,*,Auto,Auto,Auto" ColumnSpacing="8">
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding #Root.DataContext.AvailableMaterials}" SelectedValueBinding="{Binding Id}" SelectedValue="{Binding MaterialId}">
                                      <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="model:Material">
                                          <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                      </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <fa:NumberBox Grid.Column="1" Value="{Binding Quantity}" SmallChange="1" Minimum="0" SpinButtonPlacementMode="Compact" />
                                    <TextBlock Grid.Column="2" Text="{Binding UnitName}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" />
                                    <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center">
                                      <TextBlock Text="{Binding LineCostText}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" HorizontalAlignment="Right" />
                                      <TextBlock Text="{Binding UnitCostText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <Button Grid.Column="4" Classes="btn-danger btn-sm" Command="{Binding #Root.DataContext.RemoveIngredientCommand}" CommandParameter="{Binding .}">
                                      <TextBlock Text="X" />
                                    </Button>
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource CardAltBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="14" IsVisible="{Binding IsAdvancedMode}">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Overhead" FontSize="18" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="Gunakan untuk biaya utilitas, kemasan, atau tenaga kerja yang ingin masuk ke HPP." Foreground="{DynamicResource SecondaryTextBrush}" Classes="hint" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="btn-primary" Command="{Binding AddOverheadCommand}">
                    <TextBlock Text="Tambah Overhead" />
                  </Button>
                </Grid>
                <ItemsControl ItemsSource="{Binding Editor.Overheads}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:OverheadEntryViewModel">
                      <Grid Margin="0,0,0,8" ColumnDefinitions="2*,*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Text="{Binding Name}" />
                        <fa:NumberBox Grid.Column="1" Value="{Binding Cost}" SmallChange="100" Minimum="0" SpinButtonPlacementMode="Compact" />
                        <Button Grid.Column="2" Classes="btn-danger btn-sm" Command="{Binding #Root.DataContext.RemoveOverheadCommand}" CommandParameter="{Binding .}">
                          <TextBlock Text="X" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <WrapPanel Classes="action-row">
              <Button Classes="btn-primary" Command="{Binding SaveCommand}">
                <TextBlock Text="{Binding EditorActionText}" />
              </Button>
              <Button Classes="btn-secondary" Command="{Binding CancelEditCommand}">
                <TextBlock Text="Batal" />
              </Button>
            </WrapPanel>
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="12">
            <Border Classes="metric-card" Background="{DynamicResource AccentSoftBrush}">
              <StackPanel Spacing="6">
                <TextBlock Text="Ringkasan Live" FontSize="18" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="{Binding EditorPricingGuideText}" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" Classes="hint" />
              </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <Border Grid.Column="0" Classes="metric-card">
                <StackPanel Spacing="4">
                  <TextBlock Text="Biaya Bahan" Classes="kpi-label" />
                  <TextBlock Text="{Binding EditorMaterialCostText}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="metric-card">
                <StackPanel Spacing="4">
                  <TextBlock Text="Overhead" Classes="kpi-label" />
                  <TextBlock Text="{Binding EditorOverheadCostText}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
                </StackPanel>
              </Border>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <Border Grid.Column="0" Classes="metric-card">
                <StackPanel Spacing="4">
                  <TextBlock Text="Modal Batch" Classes="kpi-label" />
                  <TextBlock Text="{Binding EditorTotalCostText}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Background="{DynamicResource AccentWarmBrush}" CornerRadius="14" Padding="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="HPP per Porsi" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SidebarSelectedTextBrush}" />
                  <TextBlock Text="{Binding EditorHppText}" FontWeight="Black" Foreground="{DynamicResource SidebarSelectedTextBrush}" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Classes="metric-card">
              <StackPanel Spacing="6">
                <TextBlock Text="Checklist Studio" FontSize="18" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="1. Pastikan semua bahan punya quantity dan satuan yang benar." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Classes="hint" />
                <TextBlock Text="2. Gunakan overhead hanya untuk biaya yang memang ingin masuk ke HPP." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Classes="hint" />
                <TextBlock Text="3. Evaluasi margin target sebelum resep dipublikasikan ke POS atau combo." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Classes="hint" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="page-card" IsVisible="{Binding !IsEditing}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="4">
            <TextBlock Text="Studio Resep" FontSize="20" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBlock Text="Pilih `Tambah Resep` untuk membuat resep baru, atau `Ubah` pada kartu resep untuk memperbarui struktur biaya dan pricing." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Classes="hint" />
          </StackPanel>
          <Border Grid.Column="1" Classes="metric-card" Background="{DynamicResource AccentSoftBrush}">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding HighestHppText}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" />
              <TextBlock Text="{Binding RecipeQuickActionText}" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" Classes="hint" MaxWidth="260" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="10">
          <TextBox Text="{Binding SearchTerm}" Watermark="Cari nama resep..." />
          <TextBlock Text="{Binding SearchHelperText}" Foreground="{DynamicResource SecondaryTextBrush}" Classes="hint" />
          <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
            <Button Classes="btn-primary btn-sm" IsVisible="{Binding IsFocusAllRecipes}" Command="{Binding FocusAllRecipesCommand}">
              <TextBlock Text="{Binding FocusAllRecipesText}" />
            </Button>
            <Button Classes="btn-secondary btn-sm" IsVisible="{Binding !IsFocusAllRecipes}" Command="{Binding FocusAllRecipesCommand}">
              <TextBlock Text="{Binding FocusAllRecipesText}" />
            </Button>

            <Button Classes="btn-primary btn-sm" IsVisible="{Binding IsFocusLowMargin}" Command="{Binding FocusLowMarginCommand}">
              <TextBlock Text="{Binding FocusLowMarginText}" />
            </Button>
            <Button Classes="btn-secondary btn-sm" IsVisible="{Binding !IsFocusLowMargin}" Command="{Binding FocusLowMarginCommand}">
              <TextBlock Text="{Binding FocusLowMarginText}" />
            </Button>

            <Button Classes="btn-primary btn-sm" IsVisible="{Binding IsFocusHighMargin}" Command="{Binding FocusHighMarginCommand}">
              <TextBlock Text="{Binding FocusHighMarginText}" />
            </Button>
            <Button Classes="btn-secondary btn-sm" IsVisible="{Binding !IsFocusHighMargin}" Command="{Binding FocusHighMarginCommand}">
              <TextBlock Text="{Binding FocusHighMarginText}" />
            </Button>

            <Button Classes="btn-primary btn-sm" IsVisible="{Binding IsFocusHighHpp}" Command="{Binding FocusHighHppCommand}">
              <TextBlock Text="{Binding FocusHighHppText}" />
            </Button>
            <Button Classes="btn-secondary btn-sm" IsVisible="{Binding !IsFocusHighHpp}" Command="{Binding FocusHighHppCommand}">
              <TextBlock Text="{Binding FocusHighHppText}" />
            </Button>

            <Button Classes="btn-warm btn-sm" Command="{Binding ClearSearchAndFocusCommand}" IsVisible="{Binding HasActiveSearchOrFocus}">
              <TextBlock Text="Reset Fokus" />
            </Button>
          </WrapPanel>
          <TextBlock Text="{Binding RecipeFocusSummaryText}" Foreground="{DynamicResource SecondaryTextBrush}" Classes="hint" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Right">
          <Border Classes="badge badge-soft" Padding="14,10" HorizontalAlignment="Right">
            <TextBlock Text="{Binding SearchSummaryText}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" />
          </Border>
          <Button Classes="btn-secondary btn-sm"
                  Command="{Binding FocusRecipeQuickActionCommand}"
                  IsEnabled="{Binding HasRecipeQuickActionTarget}"
                  MaxWidth="280">
            <TextBlock Text="{Binding RecipeQuickActionButtonText}" TextWrapping="Wrap" TextAlignment="Center" />
          </Button>
        </StackPanel>
      </Grid>

      <Border Classes="page-card" IsVisible="{Binding CanProduce}">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
          <StackPanel Spacing="4">
            <TextBlock Text="Produksi Cepat" FontSize="18" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBlock Text="{Binding ProductionHelperText}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Classes="hint" />
          </StackPanel>
          <fa:NumberBox Grid.Column="1" Width="120" Value="{Binding ProduceBatches}" SmallChange="1" Minimum="1" SpinButtonPlacementMode="Compact" />
          <Button Grid.Column="2" Classes="btn-warm" Command="{Binding ProduceCommand}">
            <TextBlock Text="Produksi" />
          </Button>
        </Grid>
      </Border>

      <Border Classes="empty-state" IsVisible="{Binding !HasRecipes}">
        <StackPanel Spacing="12" HorizontalAlignment="Center">
          <lottie:Lottie Width="120" Height="120" Path="avares://HPPSystem/Assets/Animations/empty-pulse.json" />
          <TextBlock Text="Belum ada resep" FontSize="22" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" />
          <TextBlock Text="Mulai dari satu resep signature agar standar HPP, pricing, dan produksi cepat terbentuk." Foreground="{DynamicResource SecondaryTextBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" Classes="hint" />
          <Button Classes="btn-primary" Command="{Binding StartCreateCommand}" HorizontalAlignment="Center">
            <TextBlock Text="Buat Resep Pertama" />
          </Button>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="1.85*,*" ColumnSpacing="16" IsVisible="{Binding HasRecipes}">
        <Border Grid.Column="0" Classes="page-card">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="4">
                <TextBlock Text="Library Resep" FontSize="20" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="Bandingkan HPP, modal batch, struktur bahan, dan pricing dalam mode kartu atau tabel audit." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Classes="hint" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Right">
                <Border Classes="badge" VerticalAlignment="Top" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding TotalOverheadLineText}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" />
                </Border>
                <WrapPanel Classes="action-row" HorizontalAlignment="Right">
                  <Button Classes="btn-primary btn-sm" IsVisible="{Binding IsLibraryCardMode}" Command="{Binding SetLibraryCardModeCommand}">
                    <TextBlock Text="Mode Kartu" />
                  </Button>
                  <Button Classes="btn-secondary btn-sm" IsVisible="{Binding !IsLibraryCardMode}" Command="{Binding SetLibraryCardModeCommand}">
                    <TextBlock Text="Mode Kartu" />
                  </Button>
                  <Button Classes="btn-primary btn-sm" IsVisible="{Binding IsLibraryTableMode}" Command="{Binding SetLibraryTableModeCommand}">
                    <TextBlock Text="Mode Tabel" />
                  </Button>
                  <Button Classes="btn-secondary btn-sm" IsVisible="{Binding !IsLibraryTableMode}" Command="{Binding SetLibraryTableModeCommand}">
                    <TextBlock Text="Mode Tabel" />
                  </Button>
                </WrapPanel>
              </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding FilteredRecipes}" IsVisible="{Binding IsLibraryCardMode}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:RecipeCardViewModel">
                  <Border Margin="0,0,0,10" Background="{DynamicResource CardAltBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="16">
                    <StackPanel Spacing="12">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel Spacing="6">
                          <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
                          <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                            <Border Classes="badge" Padding="10,5">
                              <TextBlock Text="{Binding PortionsText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                            </Border>
                            <Border Classes="badge" Padding="10,5">
                              <TextBlock Text="{Binding MarginText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                            </Border>
                            <Border Classes="badge" Padding="10,5">
                              <TextBlock Text="{Binding GroupCountText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                            </Border>
                          </WrapPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource AccentWarmBrush}" CornerRadius="16" Padding="14,10" VerticalAlignment="Top">
                          <StackPanel Spacing="2">
                            <TextBlock Text="Rekomendasi Jual" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SidebarSelectedTextBrush}" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding RecommendedPriceText}" FontWeight="Black" Foreground="{DynamicResource SidebarSelectedTextBrush}" HorizontalAlignment="Right" />
                          </StackPanel>
                        </Border>
                      </Grid>

                      <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                        <Border Grid.Column="0" Classes="metric-card">
                          <StackPanel Spacing="4">
                            <TextBlock Text="HPP" Classes="kpi-label" />
                            <TextBlock Text="{Binding HppText}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
                          </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="metric-card">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Biaya Bahan" Classes="kpi-label" />
                            <TextBlock Text="{Binding MaterialCostText}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
                          </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Classes="metric-card">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Modal Batch" Classes="kpi-label" />
                            <TextBlock Text="{Binding TotalCostText}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
                          </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Classes="metric-card">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Struktur" Classes="kpi-label" />
                            <TextBlock Text="{Binding IngredientCountText}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="{Binding OverheadCountText}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                          </StackPanel>
                        </Border>
                      </Grid>

                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Text="Gunakan Detail untuk membaca blueprint resep, Produksi untuk mengurangi stok, dan Ubah untuk memperbarui pricing." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Classes="hint" />
                        <WrapPanel Grid.Column="1" Classes="action-row" HorizontalAlignment="Right">
                          <Button Classes="btn-ghost" Command="{Binding #Root.DataContext.SelectRecipeCommand}" CommandParameter="{Binding .}">
                            <TextBlock Text="Detail" />
                          </Button>
                          <Button Classes="btn-warm" Command="{Binding #Root.DataContext.PrepareProduceCommand}" CommandParameter="{Binding .}" IsVisible="{Binding #Root.DataContext.IsAdvancedMode}">
                            <TextBlock Text="Produksi" />
                          </Button>
                          <Button Classes="btn-secondary" Command="{Binding #Root.DataContext.DuplicateCommand}" CommandParameter="{Binding .}">
                            <TextBlock Text="Duplikat" />
                          </Button>
                          <Button Classes="btn-primary" Command="{Binding #Root.DataContext.EditCommand}" CommandParameter="{Binding .}">
                            <TextBlock Text="Ubah" />
                          </Button>
                          <Button Classes="btn-danger" Command="{Binding #Root.DataContext.RequestDeleteCommand}" CommandParameter="{Binding .}">
                            <TextBlock Text="Hapus" />
                          </Button>
                        </WrapPanel>
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Spacing="10" IsVisible="{Binding IsLibraryTableMode}">
              <dg:DataGrid Classes="audit-grid"
                           ItemsSource="{Binding FilteredRecipes}"
                           SelectedItem="{Binding SelectedRecipe}"
                           AutoGenerateColumns="False"
                           SelectionMode="Single"
                           CanUserResizeColumns="True">
                <dg:DataGrid.Columns>
                  <dg:DataGridTextColumn Header="Resep" Binding="{Binding Name}" Width="2*" />
                  <dg:DataGridTextColumn Header="Porsi" Binding="{Binding PortionsText}" Width="*" />
                  <dg:DataGridTextColumn Header="Margin" Binding="{Binding MarginText}" Width="*" />
                  <dg:DataGridTextColumn Header="HPP" Binding="{Binding HppText}" Width="*" />
                  <dg:DataGridTextColumn Header="Biaya Bahan" Binding="{Binding MaterialCostText}" Width="*" />
                  <dg:DataGridTextColumn Header="Modal Batch" Binding="{Binding TotalCostText}" Width="*" />
                  <dg:DataGridTextColumn Header="Rekomendasi" Binding="{Binding RecommendedPriceText}" Width="*" />
                  <dg:DataGridTextColumn Header="Struktur" Binding="{Binding AuditStructureText}" Width="1.5*" />
                </dg:DataGrid.Columns>
              </dg:DataGrid>

              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding SelectedRecipePricingGuideText}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Classes="hint" />
                <WrapPanel Grid.Column="1" Classes="action-row" HorizontalAlignment="Right">
                  <Button Classes="btn-warm"
                          Command="{Binding PrepareProduceCommand}"
                          CommandParameter="{Binding SelectedRecipe}"
                          IsVisible="{Binding IsAdvancedMode}"
                          IsEnabled="{Binding HasSelectedRecipe}">
                    <TextBlock Text="Produksi" />
                  </Button>
                  <Button Classes="btn-secondary"
                          Command="{Binding DuplicateCommand}"
                          CommandParameter="{Binding SelectedRecipe}"
                          IsEnabled="{Binding HasSelectedRecipe}">
                    <TextBlock Text="Duplikat" />
                  </Button>
                  <Button Classes="btn-primary"
                          Command="{Binding EditCommand}"
                          CommandParameter="{Binding SelectedRecipe}"
                          IsEnabled="{Binding HasSelectedRecipe}">
                    <TextBlock Text="Ubah" />
                  </Button>
                  <Button Classes="btn-danger"
                          Command="{Binding RequestDeleteCommand}"
                          CommandParameter="{Binding SelectedRecipe}"
                          IsEnabled="{Binding HasSelectedRecipe}">
                    <TextBlock Text="Hapus" />
                  </Button>
                </WrapPanel>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="1" Spacing="12">
          <Border Classes="page-card">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding SelectedRecipeName}" FontSize="24" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SelectedRecipeSummary}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Classes="hint" />
              <Border Classes="metric-card" Background="{DynamicResource AccentSoftBrush}">
                <TextBlock Text="{Binding SelectedRecipePricingGuideText}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" TextWrapping="Wrap" Classes="hint" />
              </Border>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Border Grid.Column="0" Classes="metric-card">
                  <StackPanel Spacing="4">
                    <TextBlock Text="HPP" Classes="kpi-label" />
                    <TextBlock Text="{Binding SelectedRecipeHppText}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="metric-card">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Rekomendasi Jual" Classes="kpi-label" />
                    <TextBlock Text="{Binding SelectedRecipeRecommendedPriceText}" FontWeight="Black" Foreground="{DynamicResource AccentWarmBrush}" />
                  </StackPanel>
                </Border>
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Border Grid.Column="0" Classes="metric-card">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Biaya Bahan" Classes="kpi-label" />
                    <TextBlock Text="{Binding SelectedRecipeMaterialCostText}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="metric-card">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Overhead" Classes="kpi-label" />
                    <TextBlock Text="{Binding SelectedRecipeOverheadCostText}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
                  </StackPanel>
                </Border>
              </Grid>
              <TextBlock Text="{Binding SelectedRecipeOperationalText}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Classes="hint" />
            </StackPanel>
          </Border>

          <Border Classes="page-card">
            <StackPanel Spacing="10">
              <TextBlock Text="Bahan" FontSize="18" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
              <dg:DataGrid Classes="audit-grid"
                           ItemsSource="{Binding SelectedRecipeIngredients}"
                           AutoGenerateColumns="False"
                           MinHeight="160">
                <dg:DataGrid.Columns>
                  <dg:DataGridTextColumn Header="Kelompok" Binding="{Binding GroupName}" Width="1.2*" />
                  <dg:DataGridTextColumn Header="Material" Binding="{Binding MaterialName}" Width="2*" />
                  <dg:DataGridTextColumn Header="Qty" Binding="{Binding QuantityText}" Width="*" />
                  <dg:DataGridTextColumn Header="Biaya Unit" Binding="{Binding UnitCostText}" Width="*" />
                  <dg:DataGridTextColumn Header="Total" Binding="{Binding TotalCostText}" Width="*" />
                </dg:DataGrid.Columns>
              </dg:DataGrid>
            </StackPanel>
          </Border>

          <Border Classes="page-card" IsVisible="{Binding IsAdvancedMode}">
            <StackPanel Spacing="10">
              <TextBlock Text="Overhead" FontSize="18" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
              <dg:DataGrid Classes="audit-grid"
                           ItemsSource="{Binding SelectedRecipeOverheads}"
                           AutoGenerateColumns="False"
                           MinHeight="140">
                <dg:DataGrid.Columns>
                  <dg:DataGridTextColumn Header="Overhead" Binding="{Binding Name}" Width="2*" />
                  <dg:DataGridTextColumn Header="Biaya" Binding="{Binding CostText}" Width="*" />
                </dg:DataGrid.Columns>
              </dg:DataGrid>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
