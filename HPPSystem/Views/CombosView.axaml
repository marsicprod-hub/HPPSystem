<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HPPSystem.ViewModels"
             xmlns:model="using:HPPSystem.Models"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
             xmlns:icon="clr-namespace:Lucide.Avalonia;assembly=Lucide.Avalonia"
             xmlns:lottie="using:Avalonia.Skia.Lottie"
             x:Class="HPPSystem.Views.CombosView"
             x:Name="Root"
             x:DataType="vm:CombosViewModel">
  <ScrollViewer Padding="0,0,14,0">
    <StackPanel Spacing="18">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
        <StackPanel Spacing="4">
          <TextBlock Text="Bundles" FontSize="{DynamicResource AppPageTitleFontSize}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
          <TextBlock Text="{Binding AnalyticsHeadlineText}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" Classes="btn-primary" Command="{Binding StartCreateCommand}" Padding="16,10" CornerRadius="14">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <icon:LucideIcon Kind="Plus" Size="16" Foreground="{DynamicResource SidebarSelectedTextBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="New Bundle" />
          </Grid>
        </Button>
      </Grid>

      <Border Classes="page-card" Background="{DynamicResource CardAltBgBrush}">
        <Grid ColumnDefinitions="1.85*,*" ColumnSpacing="14">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding AnalyticsHeadlineText}" FontSize="{DynamicResource AppDisplayFontSize}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding AnalyticsSupportText}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
          </StackPanel>
          <WrapPanel Grid.Column="1" Classes="kpi-grid">
            <Border Width="160" Classes="metric-card">
              <StackPanel Spacing="4">
                <TextBlock Text="Best Bundle" Classes="kpi-label" />
                <TextBlock Text="{Binding BestComboNameText}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding BestComboGuideText}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Width="160" Classes="metric-card">
              <StackPanel Spacing="4">
                <TextBlock Text="Benchmark Margin" Classes="kpi-label" />
                <TextBlock Text="{Binding BestComboMarginText}" FontWeight="Black" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Binding BestComboSellingPriceText}" Foreground="{DynamicResource SecondaryTextBrush}" />
              </StackPanel>
            </Border>
          </WrapPanel>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
        <Border Grid.Column="0" Classes="page-card">
          <StackPanel Spacing="8">
            <icon:LucideIcon Kind="Layers2" Size="20" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="Bundles" Classes="kpi-label" />
            <TextBlock Text="{Binding ComboCountText}" FontSize="{DynamicResource AppDisplayFontSize}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="page-card">
          <StackPanel Spacing="8">
            <icon:LucideIcon Kind="TrendingUp" Size="20" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="Average Margin" Classes="kpi-label" />
            <TextBlock Text="{Binding AverageMarginText}" FontSize="{DynamicResource AppDisplayFontSize}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="page-card">
          <StackPanel Spacing="8">
            <icon:LucideIcon Kind="TriangleAlert" Size="20" Foreground="{DynamicResource AccentRoseBrush}" />
            <TextBlock Text="Risk Bundles" Classes="kpi-label" />
            <TextBlock Text="{Binding RiskComboCountText}" FontSize="{DynamicResource AppDisplayFontSize}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="3" Classes="page-card">
          <StackPanel Spacing="8">
            <icon:LucideIcon Kind="Calculator" Size="20" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock Text="Average HPP" Classes="kpi-label" />
            <TextBlock Text="{Binding AverageHppText}" FontSize="{DynamicResource AppDisplayFontSize}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Classes="page-card" IsVisible="{Binding ShowForm}">
        <Grid ColumnDefinitions="1.8*,*" ColumnSpacing="14">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding FormTitleText}" FontSize="{DynamicResource AppCardTitleFontSize}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="{Binding FormPricingGuideText}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <Border Grid.Column="1" Classes="badge badge-warm" VerticalAlignment="Top">
                <TextBlock Text="{Binding FormMarginText}" Foreground="{DynamicResource SidebarSelectedTextBrush}" FontWeight="Bold" />
              </Border>
            </Grid>

            <Grid ColumnDefinitions="2*,*" ColumnSpacing="10">
              <TextBox Grid.Column="0" Text="{Binding FormName}" Watermark="Nama bundling" />
              <fa:NumberBox Grid.Column="1" Value="{Binding FormSellingPrice}" SmallChange="1000" Minimum="0" SpinButtonPlacementMode="Compact" />
            </Grid>

            <Border Classes="metric-card" CornerRadius="18" Padding="14">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Bundle Composition" FontSize="{DynamicResource AppSectionFontSize}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="{Binding FormRecipeCountText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="btn-primary" Command="{Binding AddRecipeEntryCommand}" Padding="12,8">
                    <TextBlock Text="Add Recipe" />
                  </Button>
                </Grid>

                <ItemsControl ItemsSource="{Binding FormRecipes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ComboRecipeEntryViewModel">
                      <Border Margin="0,0,0,8" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="12">
                        <Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="8">
                          <ComboBox Grid.Column="0"
                                    ItemsSource="{Binding #Root.DataContext.AvailableRecipes}"
                                    SelectedValueBinding="{Binding Id}"
                                    SelectedValue="{Binding RecipeId}">
                            <ComboBox.ItemTemplate>
                              <DataTemplate DataType="model:Recipe">
                                <TextBlock Text="{Binding Name}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <fa:NumberBox Grid.Column="1" Value="{Binding Qty}" SmallChange="1" Minimum="1" SpinButtonPlacementMode="Compact" />
                          <Button Grid.Column="2" Classes="btn-danger btn-sm" Command="{Binding #Root.DataContext.RemoveRecipeEntryCommand}" CommandParameter="{Binding .}">
                            <TextBlock Text="X" />
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <WrapPanel Classes="action-row">
              <Button Classes="btn-primary" Command="{Binding SaveCommand}"><TextBlock Text="{Binding FormActionText}" /></Button>
              <Button Classes="btn-secondary" Command="{Binding CancelCommand}"><TextBlock Text="Cancel" /></Button>
            </WrapPanel>
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="12">
            <Border Classes="metric-card">
              <StackPanel Spacing="6">
                <TextBlock Text="Health Cue" FontSize="{DynamicResource AppSectionFontSize}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Text="{Binding FormHealthText}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <Border Grid.Column="0" Classes="metric-card">
                <StackPanel Spacing="4">
                  <TextBlock Text="Bundle HPP" Classes="kpi-label" />
                  <TextBlock Text="{Binding FormHppText}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="metric-card">
                <StackPanel Spacing="4">
                  <TextBlock Text="Margin" Classes="kpi-label" />
                  <TextBlock Text="{Binding FormMarginText}" FontWeight="Black" Foreground="{DynamicResource AccentWarmBrush}" />
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="page-card" Background="{DynamicResource CardAltBgBrush}" IsVisible="{Binding ShowDeletePrompt}">
        <StackPanel Spacing="10">
          <TextBlock Text="Delete Bundle" FontSize="{DynamicResource AppSectionFontSize}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
          <TextBlock Text="{Binding DeletePromptText}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
          <WrapPanel Classes="action-row">
            <Button Classes="btn-danger" Command="{Binding DeleteCommand}" CommandParameter="{Binding PendingDelete}"><TextBlock Text="Delete" /></Button>
            <Button Classes="btn-ghost" Command="{Binding CancelDeleteCommand}"><TextBlock Text="Cancel" /></Button>
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Classes="empty-state" IsVisible="{Binding !HasCombos}">
        <StackPanel Spacing="12" HorizontalAlignment="Center">
          <lottie:Lottie Width="120" Height="120" Path="avares://HPPSystem/Assets/Animations/empty-pulse.json" />
          <TextBlock Text="No bundles yet" FontSize="{DynamicResource AppDisplaySmallFontSize}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
          <Button Classes="btn-primary" Command="{Binding StartCreateCommand}"><TextBlock Text="Create" /></Button>
        </StackPanel>
      </Border>

      <Border Classes="page-card" IsVisible="{Binding HasCombos}">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="Library Bundle" FontSize="{DynamicResource AppCardTitleFontSize}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
              <TextBlock Text="Gunakan mode kartu untuk browse cepat dan mode tabel untuk audit HPP, harga, serta margin bundle." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <WrapPanel Grid.Column="1" Classes="action-row" HorizontalAlignment="Right">
              <Button Classes="btn-primary btn-sm" IsVisible="{Binding IsLibraryCardMode}" Command="{Binding SetLibraryCardModeCommand}">
                <TextBlock Text="Mode Kartu" />
              </Button>
              <Button Classes="btn-secondary btn-sm" IsVisible="{Binding !IsLibraryCardMode}" Command="{Binding SetLibraryCardModeCommand}">
                <TextBlock Text="Mode Kartu" />
              </Button>
              <Button Classes="btn-primary btn-sm" IsVisible="{Binding IsLibraryTableMode}" Command="{Binding SetLibraryTableModeCommand}">
                <TextBlock Text="Mode Tabel" />
              </Button>
              <Button Classes="btn-secondary btn-sm" IsVisible="{Binding !IsLibraryTableMode}" Command="{Binding SetLibraryTableModeCommand}">
                <TextBlock Text="Mode Tabel" />
              </Button>
            </WrapPanel>
          </Grid>

          <ItemsControl ItemsSource="{Binding ComboCards}" IsVisible="{Binding IsLibraryCardMode}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:ComboCardViewModel">
                <Border Classes="page-card" Margin="0,0,0,10">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Name}" FontSize="{DynamicResource AppCardTitleFontSize}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                          <Border Classes="badge">
                            <TextBlock Text="{Binding RecipeCountText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                          </Border>
                          <Border Classes="badge badge-danger" IsVisible="{Binding IsRisky}">
                            <TextBlock Text="{Binding HealthLabelText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SidebarSelectedTextBrush}" />
                          </Border>
                          <Border Classes="badge badge-soft" IsVisible="{Binding IsHealthy}">
                            <TextBlock Text="{Binding HealthLabelText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                          </Border>
                          <Border Classes="badge" IsVisible="{Binding !IsRisky}">
                            <TextBlock Text="{Binding MarginText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                          </Border>
                        </WrapPanel>
                      </StackPanel>
                      <WrapPanel Grid.Column="1" Classes="action-row" HorizontalAlignment="Right">
                        <Button Classes="btn-primary" Command="{Binding #Root.DataContext.EditCommand}" CommandParameter="{Binding .}"><TextBlock Text="Edit" /></Button>
                        <Button Classes="btn-danger" Command="{Binding #Root.DataContext.RequestDeleteCommand}" CommandParameter="{Binding .}"><TextBlock Text="Delete" /></Button>
                      </WrapPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                      <Border Grid.Column="0" Classes="metric-card">
                        <StackPanel Spacing="4">
                          <TextBlock Text="HPP" Classes="kpi-label" />
                          <TextBlock Text="{Binding HppText}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="1" Classes="metric-card">
                        <StackPanel Spacing="4">
                          <TextBlock Text="Selling Price" Classes="kpi-label" />
                          <TextBlock Text="{Binding SellingPriceText}" FontWeight="Black" Foreground="{DynamicResource AccentWarmBrush}" />
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="2" Classes="metric-card">
                        <StackPanel Spacing="4">
                          <TextBlock Text="Margin" Classes="kpi-label" />
                          <TextBlock Text="{Binding MarginText}" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" />
                        </StackPanel>
                      </Border>
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Spacing="10" IsVisible="{Binding IsLibraryTableMode}">
            <dg:DataGrid Classes="audit-grid"
                         ItemsSource="{Binding ComboCards}"
                         SelectedItem="{Binding SelectedCombo}"
                         AutoGenerateColumns="False"
                         SelectionMode="Single"
                         CanUserResizeColumns="True">
              <dg:DataGrid.Columns>
                <dg:DataGridTextColumn Header="Bundle" Binding="{Binding Name}" Width="2*" />
                <dg:DataGridTextColumn Header="Isi" Binding="{Binding RecipeCountText}" Width="1.4*" />
                <dg:DataGridTextColumn Header="HPP" Binding="{Binding HppText}" Width="*" />
                <dg:DataGridTextColumn Header="Harga Jual" Binding="{Binding SellingPriceText}" Width="*" />
                <dg:DataGridTextColumn Header="Margin" Binding="{Binding MarginText}" Width="*" />
                <dg:DataGridTextColumn Header="Status" Binding="{Binding HealthLabelText}" Width="*" />
              </dg:DataGrid.Columns>
            </dg:DataGrid>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock Text="{Binding SelectedComboAuditText}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
              <WrapPanel Grid.Column="1" Classes="action-row" HorizontalAlignment="Right">
                <Button Classes="btn-primary"
                        Command="{Binding EditCommand}"
                        CommandParameter="{Binding SelectedCombo}"
                        IsEnabled="{Binding HasSelectedCombo}">
                  <TextBlock Text="Edit" />
                </Button>
                <Button Classes="btn-danger"
                        Command="{Binding RequestDeleteCommand}"
                        CommandParameter="{Binding SelectedCombo}"
                        IsEnabled="{Binding HasSelectedCombo}">
                  <TextBlock Text="Delete" />
                </Button>
              </WrapPanel>
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
